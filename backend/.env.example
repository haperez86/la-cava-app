# Copia este archivo como backend/.env (no se versiona) y completa los valores.
# Spring lo lee con spring.config.import=optional:file:.env[.properties].

# Base de datos de desarrollo (perfil local)
DB_URL=jdbc:postgresql://localhost:5432/la_cava
DB_USER=
DB_PASSWORD=

# Base de datos de pruebas (perfil test). Usa DB_USER y DB_PASSWORD.
DB_TEST_URL=jdbc:postgresql://localhost:5432/la_cava_test

# Secreto HS256 para firmar los JWT (mínimo 32 caracteres aleatorios).
# Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Secreto para firmar los tokens de los QR de mesa.
QR_SECRET=
